{
  "name": "angular-ui-modernization-demo",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "start": "ng serve --host 127.0.0.1",
    "build": "ng build",
    "test": "ng test --watch=false",
    "typecheck": "tsc -p tsconfig.app.json --noEmit",
    "e2e": "playwright test",
    "format:check": "prettier --check \"src/**/*.{ts,html,css}\" \"e2e/*.ts\" \"*.json\" \"*.ts\" README.md"
  },
  "dependencies": {
    "@angular/cdk": "21.2.14",
    "@angular/common": "21.2.23",
    "@angular/compiler": "21.2.23",
    "@angular/core": "21.2.23",
    "@angular/forms": "21.2.23",
    "@angular/platform-browser": "21.2.23",
    "@angular/router": "21.2.23",
    "primeng": "21.1.9",
    "rxjs": "7.8.2",
    "tslib": "2.8.1"
  },
  "devDependencies": {
    "@angular/build": "21.2.24",
    "@angular/cli": "21.2.24",
    "@angular/compiler-cli": "21.2.23",
    "@playwright/test": "1.63.0",
    "jsdom": "27.4.0",
    "prettier": "3.9.6",
    "typescript": "5.9.3",
    "vitest": "4.1.0"
  }
}
